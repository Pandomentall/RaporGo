{
  "name": "@raporgo/core",
  "version": "0.1.0",
  "description": "RaporGo dokuman modeli: sema, tipler, segment islemleri, dosya G/C",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
